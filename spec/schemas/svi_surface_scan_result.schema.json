{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svi_surface_scan_result/v1",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "svi_surface_scan_result/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slice_count", "scan_steps", "time_steps_per_interval",
                     "minimum_durrleman_value", "log_moneyness_at_minimum_durrleman_value",
                     "years_to_expiry_at_minimum_durrleman_value", "minimum_risk_neutral_density",
                     "minimum_total_variance_time_slope", "log_moneyness_at_minimum_time_slope",
                     "years_to_expiry_at_minimum_time_slope", "minimum_local_variance",
                     "log_moneyness_at_minimum_local_variance", "years_to_expiry_at_minimum_local_variance",
                     "worst_local_variance_round_trip_error", "log_moneyness_at_worst_round_trip_error",
                     "round_trip_point_count", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slice_count": { "type": "integer", "minimum": 2 },
          "scan_steps": { "type": "integer", "minimum": 2 },
          "time_steps_per_interval": { "type": "integer", "minimum": 1 },
          "minimum_durrleman_value": { "type": "number" },
          "log_moneyness_at_minimum_durrleman_value": { "type": "number" },
          "years_to_expiry_at_minimum_durrleman_value": { "type": "number" },
          "minimum_risk_neutral_density": { "type": "number" },
          "minimum_total_variance_time_slope": { "type": "number" },
          "log_moneyness_at_minimum_time_slope": { "type": "number" },
          "years_to_expiry_at_minimum_time_slope": { "type": "number" },
          "minimum_local_variance": { "type": "number" },
          "log_moneyness_at_minimum_local_variance": { "type": "number" },
          "years_to_expiry_at_minimum_local_variance": { "type": "number" },
          "worst_local_variance_round_trip_error": { "type": "number", "minimum": 0 },
          "log_moneyness_at_worst_round_trip_error": { "type": "number" },
          "round_trip_point_count": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["arbitrage_free_on_grid", "butterfly_arbitrage_found",
                               "calendar_arbitrage_found", "invalid_surface"] }
        }
      }
    }
  }
}
