{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pricing_request/v1",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pricing_request/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "forward", "strike", "years_to_expiry", "volatility", "discount_factor", "option_type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "forward": { "type": "number", "exclusiveMinimum": 0 },
          "strike": { "type": "number", "exclusiveMinimum": 0 },
          "years_to_expiry": { "type": "number", "minimum": 0 },
          "volatility": { "type": "number", "minimum": 0 },
          "discount_factor": { "type": "number", "exclusiveMinimum": 0 },
          "option_type": { "enum": ["call", "put"] }
        }
      }
    }
  }
}
