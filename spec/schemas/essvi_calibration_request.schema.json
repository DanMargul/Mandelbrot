{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "essvi_calibration_request/v1",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "essvi_calibration_request/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slices", "lowest_log_moneyness", "highest_log_moneyness"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["years_to_expiry", "observations"],
              "additionalProperties": false,
              "properties": {
                "years_to_expiry": { "type": "number", "exclusiveMinimum": 0 },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["log_moneyness", "total_variance", "weight"],
                    "additionalProperties": false,
                    "properties": {
                      "log_moneyness": { "type": "number" },
                      "total_variance": { "type": "number" },
                      "weight": { "type": "number", "minimum": 0 }
                    }
                  }
                }
              }
            }
          },
          "lowest_log_moneyness": { "type": "number" },
          "highest_log_moneyness": { "type": "number" }
        }
      }
    }
  }
}
