{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correlation_request/v1",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "correlation_request/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "constituents", "index_volatility", "index_vega"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "constituents": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["symbol", "weight", "volatility"],
              "additionalProperties": false,
              "properties": {
                "symbol": { "type": "string", "minLength": 1 },
                "weight": { "type": "number", "exclusiveMinimum": 0 },
                "volatility": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "index_volatility": { "type": "number", "exclusiveMinimum": 0 },
          "index_vega": { "type": "number" }
        }
      }
    }
  }
}
