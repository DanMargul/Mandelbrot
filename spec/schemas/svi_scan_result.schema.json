{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svi_scan_result/v1",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "svi_scan_result/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "minimum_durrleman_value", "log_moneyness_at_minimum",
                     "minimum_total_variance", "minimum_risk_neutral_density", "scan_steps", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "minimum_durrleman_value": { "type": "number" },
          "log_moneyness_at_minimum": { "type": "number" },
          "minimum_total_variance": { "type": "number" },
          "minimum_risk_neutral_density": { "type": "number" },
          "scan_steps": { "type": "integer", "minimum": 2 },
          "status": { "enum": ["arbitrage_free_on_grid", "butterfly_arbitrage_found", "invalid_parameters"] }
        }
      }
    }
  }
}
